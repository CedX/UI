<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Company>Cedric-Belin.fr</Company>
		<Copyright>© Cédric Belin</Copyright>
		<Description>Web component library by Cédric Belin, full stack developer.</Description>
		<Product>Belin UI</Product>
		<Version>2026.11.0</Version>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>CedX</Authors>
		<IncludeSymbols>true</IncludeSymbols>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>ReadMe.md</PackageReadmeFile>
		<PackageTags>belin;components;html;library;ui</PackageTags>
		<RepositoryUrl>https://github.com/CedX/UI.git</RepositoryUrl>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>CedX</Authors>
		<IncludeSymbols>true</IncludeSymbols>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>ReadMe.md</PackageReadmeFile>
		<PackageTags>belin;components;fable;html;library;razor;ui</PackageTags>
		<RepositoryUrl>https://github.com/CedX/UI.git</RepositoryUrl>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<PropertyGroup>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AssemblyName>Belin.UI</AssemblyName>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutDir>../../Binaries</OutDir>
		<RootNamespace>Belin.UI</RootNamespace>
		<TargetFramework>net11.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="$(RootNamespace).Tests" />
		<None Include="../../Icon.png" Pack="true" PackagePath="" />
		<None Include="../../ReadMe.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="Alignment.fs" />
		<Compile Include="AppTheme.fs" />
		<Compile Include="Context.fs" />
		<Compile Include="DateTime.fs" />
		<Compile Include="DialogResult.fs" />
		<Compile Include="KeyboardModifiers.fs" />
		<Compile Include="Pagination.fs" />
		<Compile Include="Position.fs" />
		<Compile Include="Scenario.fs" />
		<Compile Include="Size.fs" />
		<Compile Include="Sort.fs" />
		<Compile Include="StorageArea.fs" />
		<Compile Include="String.fs" />
		<Compile Include="Variant.fs" />
	</ItemGroup>
</Project>
