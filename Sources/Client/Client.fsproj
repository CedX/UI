<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Company>Cedric-Belin.fr</Company>
		<Copyright>© Cédric Belin</Copyright>
		<Description>Web component library by Cédric Belin, full stack developer.</Description>
		<Product>Belin UI</Product>
		<Version>0.40.0</Version>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>CedX</Authors>
		<IncludeSymbols>true</IncludeSymbols>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>ReadMe.md</PackageReadmeFile>
		<PackageTags>belin;components;fable;html;library;razor;ui</PackageTags>
		<RepositoryUrl>https://github.com/CedX/UI.git</RepositoryUrl>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<PropertyGroup>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AssemblyName>Belin.UI</AssemblyName>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<HotReloadAutoRestart>true</HotReloadAutoRestart>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutDir>../../Binaries</OutDir>
		<RootNamespace>Belin.UI</RootNamespace>
		<TargetFramework>net11.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="$(RootNamespace).Tests" />
		<None Include="../../Icon.png" Pack="true" PackagePath="" />
		<None Include="../../ReadMe.md" Pack="true" PackagePath="" />
		<PackageReference Update="FSharp.Core" Version="10.1.403" />
		<PackageReference Include="Fable.Browser.Dom" Version="2.20.0" />
		<PackageReference Include="Fable.Core" Version="5.6.1" />
		<PackageReference Include="Fable.JsonProvider" Version="1.1.1" />
		<PackageReference Include="Fable.Promise" Version="3.3.0" />
	</ItemGroup>
</Project>
